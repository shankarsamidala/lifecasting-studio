# Copy to .env and fill in. Never commit the real .env.
#
# ------------------------------------------------------------------
# DATABASE — Supabase Postgres
# ------------------------------------------------------------------
# Supabase dashboard -> Connect -> choose the SHARED POOLER, not the
# direct connection. The direct connection (db.[REF].supabase.co) is
# IPv6-only on the free plan and will time out from most hosts.
#
# Session mode (port 5432) — long-lived server: a VPS, or Cloud Run
# with min-instances >= 1:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[INDEX]-[REGION].pooler.supabase.com:5432/postgres
#
# Transaction mode (port 6543) — serverless scaling from zero.
# settings.py detects port 6543 and disables prepared statements and
# server-side cursors automatically:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[INDEX]-[REGION].pooler.supabase.com:6543/postgres
#
# NOTE: the pooler username is postgres.[PROJECT-REF], not postgres.
# If the password contains @ : / or #, percent-encode it.

# ------------------------------------------------------------------
# Django
# ------------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=lifecastingstudio.in,www.lifecastingstudio.in
# Required on Django 4+ behind a proxy, or the contact form returns 403:
DJANGO_CSRF_TRUSTED_ORIGINS=https://lifecastingstudio.in,https://www.lifecastingstudio.in
